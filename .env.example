# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Platform WhatsApp number, with country code, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Admin panel (/admin). Choose a long random password and a 32+ char random secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public site URL (used for sitemap / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for `npm run db:migrate` / `db:seed` (never used by the website at runtime).
# Supabase dashboard -> Connect -> Session pooler URI, with your database password filled in.
DATABASE_URL=

# Default platform margin (%) added to the owner's price. You can change it per listing when approving.
DEFAULT_MARGIN_PERCENT=25
