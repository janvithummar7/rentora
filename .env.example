# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Platform WhatsApp number, with country code, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Admin panel (/admin). Choose a long random password and a 32+ char random secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public site URL (used for sitemap / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
